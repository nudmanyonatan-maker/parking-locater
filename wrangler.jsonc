// Cloudflare Worker config: React SPA (static assets) + API Worker + KV (car spot)
// + D1 (cameras, detections) + Workers AI + cron. The name keeps the existing
// parking-locator URL, KV data and DISCORD_WEBHOOK_URL secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parking-locator",
  // Yonatan Personal (moved from Excel Capital's account on 2026-11-23).
  "account_id": "5b2882e13ebf9af360e3eb3f3d265ed1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // API routes always hit the Worker; everything else is the SPA.
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "kv_namespaces": [{ "binding": "PARKING_KV", "id": "ff6910e086db4264a7c8a85f00fa93f6" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parknearme",
      // The "parknearme" D1 database in Yonatan Personal. `npm run db:ensure` rewrites it
      // if the database is ever recreated.
      "database_id": "706907e6-9945-458f-a188-32eb2a13e470",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI always runs on Cloudflare (no local simulation); calls are billed.
  "ai": { "binding": "AI", "remote": true },
  "triggers": {
    // Every minute: move-by reminder. Even minutes: background camera analysis,
    // skipped unless alerts are on or the app was opened recently (worker/cron.ts).
    "crons": ["* * * * *"]
  },
  "vars": {
    "DETECTOR": "auto",
    "APP_VERSION": "0.1.0",
    "VAPID_SUBJECT": "https://parking-locator.nudman.workers.dev"
  },
  "observability": { "enabled": true }
}
